# Jesus Revival for All Nations — HostGator (Apache) settings for the React site.

DirectoryIndex index.html
# Slashes are handled below, so a page and a folder can share a name (/giving and /giving/volunteer)
DirectorySlash Off
Options -Indexes -MultiViews
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /about.html -> /about (one clean address per page)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
  RewriteCond %1 !(^|/)index$
  RewriteRule ^ /%1 [R=301,L]

  # /about/ -> /about (unless it is a real folder with its own index.html, e.g. /admin/)
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # Pages with their own share preview (about.html, contact.html...: see scripts/social-pages.mjs)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*[^/])$ $1.html [L]

  # Real folders with their own index.html get their slash: /admin -> /admin/
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/ [R=301,L]

  # Real files, and folders that have their own index.html (e.g. /admin/), are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Every other address is a page of the React app
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Built files have a fingerprint in their name, so they can be cached for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages are always re-checked, so a new deploy shows up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The upload tool's bookkeeping file stays private
  <Files ".ftp-deploy-sync-state.json">
    Require all denied
  </Files>
  # Source maps are for debugging only
  <FilesMatch "\.map$">
    Require all denied
  </FilesMatch>
</IfModule>
